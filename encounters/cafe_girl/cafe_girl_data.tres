[sub_resource type="Resource" id="DialogueChoice_who"]
script = ExtResource("3")
question = "What's your name?"
response_lines = Array[String](["\"Cherry,\" she says, like it should've been obvious.", "\"Don't wear it out.\""])

[sub_resource type="Resource" id="DialogueChoice_where"]
script = ExtResource("3")
question = "What is this place?"
response_lines = Array[String](["\"My place,\" she shrugs. \"Well. Sort of.\"", "\"You'll understand soon enough.\""])

[resource]
script = ExtResource("1")
enemy_name = "Cherry"
enemy_max_hp = 20
intro_lines = Array[String](["The cafe smells like vanilla and something sweeter underneath it.", "A girl with long pink hair waves you over to the bar.", "\"Took you long enough,\" she smiles. \"Sit with me?\""])
