[sub_resource type="Resource" id="DialogueChoice_who"]
script = ExtResource("3")
question = "Who are you?"
response_lines = Array[String](["I am the single eye of the Video Dimension.", "No pixel, no frame, escapes my sight."])

[sub_resource type="Resource" id="DialogueChoice_why"]
script = ExtResource("3")
question = "Why are you here?"
response_lines = Array[String](["I watch over these screens, until someone can best me.", "Beat me, and you'll finally control this dimension's display."])

[resource]
